# backend-alsinext (spec 007). Copia este archivo como .env y rellénalo en el servidor.
# Nunca subas el .env a git ni pegues sus valores en el chat.

# Puerto: el mismo que backend-alsina-tools-vc; no se pueden encender los dos a la vez
PORT=3001

# Base de datos (la misma de siempre, alsina_portal). Obligatorias: DB_HOST, DB_USER, DB_NAME
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=alsina_portal

# Secreto para firmar el token de administrador (obligatorio, el mismo que backend-alsina-tools-vc,
# mínimo 32 caracteres: si es más corto, las rutas de administrador responden 503 not_configured).
# Una sola línea JWT_SECRET: si se repite, vale la última.
JWT_SECRET=

# Gemini (afinidad y títulos). Sin clave el backend arranca, pero no puede emparejar ni dar títulos
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
